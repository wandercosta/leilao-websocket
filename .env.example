# Copie para .env:  cp .env.example .env
# Os valores abaixo são de exemplo. Troque as senhas e o APP_SECRET fora do ambiente local.

# Banco de dados (no Docker o host é o serviço "db")
DB_HOST=db
DB_PORT=3306
DB_DATABASE=leilao
DB_USERNAME=leilao
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Chave usada para assinar o token que o navegador envia ao servidor WebSocket.
# Gere uma nova com:  php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=exemplo-troque-por-uma-chave-aleatoria-de-64-caracteres-0000000

# Servidor WebSocket
WS_PORT=8090
WS_PUBLIC_URL=ws://localhost:8090

# Portas publicadas no seu computador
APP_HTTP_PORT=8000
TZ=America/Sao_Paulo
